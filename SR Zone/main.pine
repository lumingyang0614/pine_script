//@version=5
indicator("SR Zones (Rejection-based, No ADX)", overlay=true, max_boxes_count=200, max_labels_count=200)

//==============================
// Inputs
//==============================
grp0 = "Pivot"
leftBars  = input.int(5, "Pivot Left", minval=1, group=grp0)
rightBars = input.int(5, "Pivot Right (confirm)", minval=1, group=grp0)

grp1 = "Zone 合併/數量"
atrLen     = input.int(14, "ATR Len", minval=1, group=grp1)
mergeAtr   = input.float(0.8, "合併距離 = ATR *", minval=0.1, step=0.1, group=grp1)
maxZones   = input.int(16, "最多保留 zones", minval=5, maxval=60, group=grp1)

grp2 = "厚度自適應"
minWidthATR = input.float(0.35, "最小半厚度 = ATR*", minval=0.05, step=0.05, group=grp2)
stdMult     = input.float(1.8,  "自適應半厚度 = StdDev*", minval=0.2, step=0.1, group=grp2)
wickMult    = input.float(1.0,  "影線厚度倍率", minval=0.1, step=0.1, group=grp2)
maxWidthATR = input.float(2.0,  "最大半厚度 = ATR*", minval=0.3, step=0.1, group=grp2)

grp3 = "Rejection 規則（重點）"
rejWindow   = input.int(8, "N 根內要完成拒絕", minval=1, maxval=50, group=grp3)
rejMoveATR  = input.float(1.2, "拒絕位移 >= ATR*", minval=0.1, step=0.1, group=grp3)
cooldownBars= input.int(20, "同一 zone 冷卻 bars（避免磨擦刷次）", minval=0, maxval=500, group=grp3)
minTouches  = input.int(3, "至少幾次有效觸碰才顯示", minval=2, maxval=20, group=grp3)
bodyCrossPenalty = input.int(1, "實體穿越扣分", minval=0, maxval=10, group=grp3)
maxBodyCross     = input.int(6, "實體穿越上限(超過隱藏)", minval=1, maxval=50, group=grp3)
bodyCrossMinPct  = input.float(0.35, "實體穿入比例(0~1)", minval=0.05, maxval=1.0, step=0.05, group=grp3)

grp4 = "顯示"
extendRight = input.bool(true, "向右延伸", group=grp4)
zoneColor   = input.color(color.new(color.orange, 0), "區域色", group=grp4)
fillOp      = input.int(88, "填色透明度(0~100)", minval=0, maxval=100, group=grp4)
borderOp    = input.int(45, "邊框透明度(0~100)", minval=0, maxval=100, group=grp4)

//==============================
// Core series
//==============================
atr = ta.atr(atrLen)
mergeTol = atr * mergeAtr
rejMove  = atr * rejMoveATR

//==============================
// Zone storage (clusters)
// mean/m2/n: Welford for stddev of pivot prices inside a zone
// typ:  1 = Resistance (from pivot highs), -1 = Support (from pivot lows)
// touches: effective rejection touches
// lastTouchBar: last time a rejection touch was counted (cooldown)
// pending: zone currently waiting to see rejection
// pendingStartBar: bar_index when touch started
// pendingType: 1 means expecting rejection DOWN (from resistance); -1 means expecting rejection UP (from support)
// box handle
var float[] zMean = array.new_float()
var float[] zM2   = array.new_float()
var int[]   zN    = array.new_int()
var int[]   zTouch= array.new_int()
var int[]   zBodyCross = array.new_int()
var int[]   zFirstTouchBar = array.new_int()
var int[]   zFirstTouchTime = array.new_int()
var int[]   zLastTouchBar = array.new_int()
var int[]   zLastTouchTime = array.new_int()
var int[]   zInvalidTime = array.new_int()
var bool[]  zPending = array.new_bool()
var int[]   zPendBar = array.new_int()
var int[]   zPendTime = array.new_int()
var float[] zWick = array.new_float()
var box[]   zBox  = array.new_box()

//==============================
// Helpers
//==============================
f_std(int i) =>
    n = array.get(zN, i)
    m2 = array.get(zM2, i)
    n > 1 ? math.sqrt(m2 / (n - 1)) : 0.0

f_halfwidth(int i) =>
    sd = f_std(i)
    minH = atr * minWidthATR
    maxH = atr * maxWidthATR
    wickH = array.get(zWick, i) * wickMult
    h = math.max(minH, math.max(sd * stdMult, wickH))
    math.min(h, maxH)

f_top(int i) =>
    array.get(zMean, i) + f_halfwidth(i)

f_bot(int i) =>
    array.get(zMean, i) - f_halfwidth(i)

// find nearest zone of same type within mergeTol
f_find_zone(float price) =>
    int idx = -1
    float best = 10e10
    int n = array.size(zMean)
    if n == 0
        idx
    else
        for k = 0 to n - 1
            d = math.abs(array.get(zMean, k) - price)
            if d < best
                best := d
                idx := k
        if idx != -1 and best <= mergeTol
            idx
        else
            -1

// Welford update for mean/std
f_update_stats(int i, float x, float wick) =>
    n0 = array.get(zN, i)
    mean0 = array.get(zMean, i)
    m20 = array.get(zM2, i)

    n1 = n0 + 1
    delta = x - mean0
    mean1 = mean0 + delta / n1
    delta2 = x - mean1
    m21 = m20 + delta * delta2

    array.set(zN, i, n1)
    array.set(zMean, i, mean1)
    array.set(zM2, i, m21)
    array.set(zWick, i, math.max(array.get(zWick, i), wick))

f_new_zone(float price, float wick) =>
    array.push(zMean, price)
    array.push(zM2, 0.0)
    array.push(zN, 1)
    array.push(zTouch, 0)
    array.push(zBodyCross, 0)
    array.push(zFirstTouchBar, na)
    array.push(zFirstTouchTime, na)
    array.push(zLastTouchBar, -1000000)
    array.push(zLastTouchTime, na)
    array.push(zInvalidTime, na)
    array.push(zPending, false)
    array.push(zPendBar, na)
    array.push(zPendTime, na)
    array.push(zWick, wick)
    array.push(zBox, na)

f_delete_zone(int i) =>
    b = array.get(zBox, i)
    if not na(b)
        box.delete(b)
    array.remove(zMean, i)
    array.remove(zM2, i)
    array.remove(zN, i)
    array.remove(zTouch, i)
    array.remove(zBodyCross, i)
    array.remove(zFirstTouchBar, i)
    array.remove(zFirstTouchTime, i)
    array.remove(zLastTouchBar, i)
    array.remove(zLastTouchTime, i)
    array.remove(zInvalidTime, i)
    array.remove(zPending, i)
    array.remove(zPendBar, i)
    array.remove(zPendTime, i)
    array.remove(zWick, i)
    array.remove(zBox, i)

// keep only strongest zones by touches (remove lowest)
// disabled: user wants no merge/trim
f_trim_zones() =>
    0

f_render(int i) =>
    touches = array.get(zTouch, i)
    crosses = array.get(zBodyCross, i)
    int effective = math.max(0, touches - crosses * bodyCrossPenalty)
    invalidTime = array.get(zInvalidTime, i)
    if effective >= minTouches
        top = f_top(i)
        bot = f_bot(i)
        leftTime = array.get(zFirstTouchTime, i)
        rightTime = not na(invalidTime) ? invalidTime : (extendRight ? time : array.get(zLastTouchTime, i))
        b = array.get(zBox, i)
        if na(b) and not na(leftTime) and not na(rightTime)
            nb = box.new(leftTime, top, rightTime, bot, xloc=xloc.bar_time, bgcolor=color.new(zoneColor, fillOp), border_color=color.new(zoneColor, borderOp))
            if extendRight and na(invalidTime)
                box.set_extend(nb, extend.right)
            array.set(zBox, i, nb)
        else if not na(b)
            if not na(leftTime)
                box.set_left(b, leftTime)
            if not na(rightTime)
                box.set_right(b, rightTime)
            if not na(invalidTime)
                box.set_extend(b, extend.none)
            box.set_top(b, top)
            box.set_bottom(b, bot)
            box.set_bgcolor(b, color.new(zoneColor, fillOp))
            box.set_border_color(b, color.new(zoneColor, borderOp))
    0

f_pivot_wick(int off, bool isHigh) =>
    float upper = high[off] - math.max(open[off], close[off])
    float lower = math.min(open[off], close[off]) - low[off]
    isHigh ? upper : lower

//==============================
// 1) Build/merge zones from confirmed pivots
//==============================
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

if not na(ph)
    price = ph
    wick = f_pivot_wick(rightBars, true)
    idx = f_find_zone(price)
    if idx == -1
        f_new_zone(price, wick)
    else
        f_update_stats(idx, price, wick)
    f_trim_zones()

if not na(pl)
    price = pl
    wick = f_pivot_wick(rightBars, false)
    idx = f_find_zone(price)
    if idx == -1
        f_new_zone(price, wick)
    else
        f_update_stats(idx, price, wick)
    f_trim_zones()

//==============================
// 2) Rejection touch detection
//    - Touch starts when price overlaps zone and cooldown is satisfied
//    - Count touch ONLY if within rejWindow bars price moves away by rejMove (ATR*X)
//==============================
int nZ = array.size(zMean)
if nZ > 0
    for i = 0 to nZ - 1
        top = f_top(i)
        bot = f_bot(i)
        float bodyHigh = math.max(open, close)
        float bodyLow = math.min(open, close)
        float overlap = math.max(0.0, math.min(bodyHigh, top) - math.max(bodyLow, bot))
        float zoneH = math.max(top - bot, syminfo.mintick)
        bool bodyCross = overlap / zoneH >= bodyCrossMinPct
        if bodyCross
            int newCross = array.get(zBodyCross, i) + 1
            array.set(zBodyCross, i, newCross)
            if newCross > maxBodyCross and na(array.get(zInvalidTime, i))
                array.set(zInvalidTime, i, time)

        inZone = (high >= bot) and (low <= top)

        pending = array.get(zPending, i)
        lastTBar = array.get(zLastTouchBar, i)
        canStart = (bar_index - lastTBar) > cooldownBars

        // Start pending rejection when we first touch the zone (and not already pending)
        if not pending and inZone and canStart
            array.set(zPending, i, true)
            array.set(zPendBar, i, bar_index)
            array.set(zPendTime, i, time)

        // Evaluate pending window
        if array.get(zPending, i)
            startBar = array.get(zPendBar, i)

            // expire if window exceeded
            if bar_index - startBar > rejWindow
                array.set(zPending, i, false)
            else
                // rejection condition:
                // any direction move away by rejMove
                bool rejected = false
                rejected := close <= (bot - rejMove) or close >= (top + rejMove)

                if rejected
                    if array.get(zTouch, i) == 0
                        array.set(zFirstTouchBar, i, bar_index)
                        array.set(zFirstTouchTime, i, time)
                    array.set(zTouch, i, array.get(zTouch, i) + 1)
                    array.set(zLastTouchBar, i, bar_index)
                    array.set(zLastTouchTime, i, time)
                    array.set(zPending, i, false)

//==============================
// 3) Render
//==============================
int nR = array.size(zMean)
if nR > 0
    for i = 0 to nR - 1
        f_render(i)
