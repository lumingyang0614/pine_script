//@version=5
indicator("Harmonic Pro+ Strict Multi-Pattern Scanner", overlay=true, max_bars_back=5000, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ---------------- Inputs ----------------
grpPivot = "Pivot (轉折)"
pivotLeftBars = input.int(3, "Pivot Left Bars (左側轉折根數)", minval=1, group=grpPivot)
pivotRightBars = input.int(3, "Pivot Right Bars (右側轉折根數)", minval=1, group=grpPivot)

grpScan = "Scan Period Settings (掃描週期設定)"
scanStartLen = input.int(1, "Start Length (掃描週期下限)", minval=1, maxval=100, group=grpScan)
scanEndLen = input.int(120, "End Length (掃描週期上限)", minval=1, maxval=200, group=grpScan)
scanRangeStep = input.int(1, "Range Step (掃描週期間隔)", minval=1, maxval=20, group=grpScan)

grpPattern = "Pattern (型態)"
enableGartley = input.bool(true, "Enable Gartley (啟用 Gartley)", group=grpPattern)
enableDeepGartley = input.bool(true, "Enable Deep Gartley (啟用 Deep Gartley)", group=grpPattern)
enableBat = input.bool(true, "Enable Bat (啟用 Bat)", group=grpPattern)
enableAltBat = input.bool(true, "Enable Alternate Bat (啟用 Alternate Bat)", group=grpPattern)
enableButterfly = input.bool(true, "Enable Butterfly (啟用 Butterfly)", group=grpPattern)
enableCrab = input.bool(true, "Enable Crab (啟用 Crab)", group=grpPattern)
enableDeepCrab = input.bool(true, "Enable Deep Crab (啟用 Deep Crab)", group=grpPattern)
enableCypher = input.bool(true, "Enable Cypher (啟用 Cypher)", group=grpPattern)
cypherLogicMode = input.string("Reference (C outside XA)", "Cypher Logic Mode (Cypher 邏輯模式)", options=["Reference (C outside XA)", "Custom (C inside XA)"], group=grpPattern)
sharkLogicMode = input.string("Reference (XB/XA+AC/XA+BD/XA+XD/XA)", "Shark Logic Mode (鯊魚邏輯模式)", options=["Reference (XB/XA+AC/XA+BD/XA+XD/XA)", "Reference (XB/XA+AC/XA+BD/BC+XD/XA)", "Classic OX"], group=grpPattern)
enableShark0886 = input.bool(true, "Enable Shark 0.886 (啟用 Shark 0.886)", group=grpPattern)
enableShark113 = input.bool(true, "Enable Shark 1.13 (啟用 Shark 1.13)", group=grpPattern)
enableFiveO = input.bool(true, "Enable 5-0 (啟用 5-0)", group=grpPattern)

grpTol = "Tolerance (容錯)"
ratioTolerance = input.float(0.08, "Ratio Tolerance (比例容錯)", minval=0.001, maxval=0.2, step=0.001, group=grpTol)

grpRisk = "Risk (風控)"
entryMode = input.string("Basic", "Entry Mode (進場模式)", options=["Basic", "Strict"], group=grpRisk)
tpMode = input.string("Auto", "TP Mode (停利模式)", options=["AD", "CD", "Auto"], group=grpRisk)
slBufferMode = input.string("ATR", "SL Buffer Mode (停損緩衝模式)", options=["Percent", "ATR"], group=grpRisk)
slBufferPercent = input.float(0.30, "SL Buffer Percent (停損緩衝百分比)", minval=0.01, step=0.01, group=grpRisk)
slAtrLen = input.int(14, "SL ATR Length (停損 ATR 週期)", minval=1, group=grpRisk)
slAtrMult = input.float(0.25, "SL ATR Multiplier (停損 ATR 倍數)", minval=0.01, step=0.01, group=grpRisk)
useCypherXStop = input.bool(true, "Cypher SL at X Outside (Cypher 停損放在 X 外側)", group=grpRisk)
hitToleranceTicks = input.int(1, "Hit Tolerance Ticks (觸價容差Ticks)", minval=0, maxval=20, group=grpRisk)

grpFilter = "Filters (濾網)"
useTimeSymmetry = input.bool(false, "Use Time Symmetry Filter (使用時間對稱濾網)", group=grpFilter)
maxLegBarRatio = input.float(3.0, "Max Leg Bar Ratio (腿長時間比上限)", minval=1.2, step=0.1, group=grpFilter)
useMinLegSize = input.bool(false, "Use Minimum Leg Size Filter (使用最小腿長濾網)", group=grpFilter)
minLegATRMultiple = input.float(0.3, "Min Leg ATR Multiple (最小腿長 ATR 倍數)", minval=0.1, step=0.1, group=grpFilter)
useCandleConfirmation = input.bool(true, "Use Candle Confirmation (使用 K 棒確認)", group=grpFilter)

grpDisplay = "Display (顯示)"
showPRZ = input.bool(true, "Show PRZ Zone (顯示 PRZ 區域)", group=grpDisplay)
showSLTP = input.bool(true, "Show SL/TP Lines (顯示 SL/TP 線)", group=grpDisplay)
showScore = input.bool(true, "Show Pattern Score (顯示型態分數)", group=grpDisplay)
showRatioNumbers = input.bool(true, "Show Ratio Numbers (顯示比例數字)", group=grpDisplay)
showOnlyBestPattern = input.bool(false, "Show Only Best Pattern (只顯示最佳型態)", group=grpDisplay)
showStatsTable = input.bool(true, "Show Statistics Table (顯示統計表)", group=grpDisplay)
showTP3 = input.bool(false, "Show TP3 (B Point) (顯示 TP3/B 點)", group=grpDisplay)
projectionBars = input.int(80, "Projection Bars (投射線長度)", minval=10, maxval=500, group=grpDisplay)

grpAlert = "Alerts (警報)"
enableRuntimeAlert = input.bool(false, "Enable Runtime alert() Messages (啟用即時 alert 訊息)", group=grpAlert)

// ---------------- Core state ----------------
float atrSeries = ta.atr(slAtrLen)

var string[] patternNames = array.from("Gartley", "Deep Gartley", "Bat", "Alternate Bat", "Butterfly", "Crab", "Deep Crab", "Cypher", "Shark 0.886", "Shark 1.13", "5-0")
var int[] statTotal = array.new_int(11, 0)
var int[] statTP1 = array.new_int(11, 0)
var int[] statTP2 = array.new_int(11, 0)
var int[] statSL = array.new_int(11, 0)
var table statsTbl = table.new(position.bottom_right, 5, 12, frame_color=color.new(color.white, 70), border_width=1, bgcolor=color.new(color.black, 82))

var int[] swBars = array.new_int()
var float[] swPrice = array.new_float()
var int[] swType = array.new_int() // 1=high, -1=low

// Multi-scale independent scan state (avoid mixing pivots from different lengths)
var int scanLenCap = 220
scanPivotDepth = 6
scanComboCount = 6
var float[] msPrice = array.new_float((220 + 1) * 6, na)
var int[] msBar = array.new_int((220 + 1) * 6, na)
var int[] msType = array.new_int((220 + 1) * 6, 0)
var int[] msLastType = array.new_int(220 + 1, 0)

var string[] emittedKeys = array.new_string()
var bool[] keepBull = array.new_bool()
var string[] keepPn = array.new_string()
var int[] keepD = array.new_int()
var float[] keepEntry = array.new_float()
var float[] keepScore = array.new_float()

var string[] trKey = array.new_string()
var string[] trPattern = array.new_string()
var bool[] trBull = array.new_bool()
var float[] trPrzLow = array.new_float()
var float[] trPrzHigh = array.new_float()
var float[] trEntry = array.new_float()
var float[] trSL = array.new_float()
var float[] trTP1 = array.new_float()
var float[] trTP2 = array.new_float()
var bool[] trStarted = array.new_bool()
var bool[] trTP1Hit = array.new_bool()
var label[] trLabelRef = array.new_label()
var string[] trLabelHead = array.new_string()
var string[] trLabelBody = array.new_string()

// ---------------- Utility ----------------
inRange(value, low, high) =>
    value >= low and value <= high

near(value, target, tolerance) =>
    math.abs(value - target) <= math.abs(target) * tolerance

inRangeTol(value, low, high) =>
    inRange(value, low * (1.0 - ratioTolerance), high * (1.0 + ratioTolerance))

nearTol(value, target) =>
    near(value, target, ratioTolerance)

clamp01(v) =>
    math.max(0.0, math.min(1.0, v))

fmtRatio(v) =>
    str.tostring(v, "#.###")

hitTol() =>
    syminfo.mintick * hitToleranceTicks

isInPrzBar(h, l, przLow, przHigh, tol) =>
    h >= (przLow - tol) and l <= (przHigh + tol)

isHitTP1Bar(isBull, h, l, tp1, tol) =>
    isBull ? (h >= (tp1 - tol)) : (l <= (tp1 + tol))

isHitTP2Bar(isBull, h, l, tp2, tol) =>
    isBull ? (h >= (tp2 - tol)) : (l <= (tp2 + tol))

isHitSLBar(isBull, h, l, sl, tol) =>
    isBull ? (l <= (sl + tol)) : (h >= (sl - tol))

scoreNear(v, target) =>
    float err = math.abs(v - target) / math.max(math.abs(target), syminfo.mintick)
    100.0 * (1.0 - clamp01(err / ratioTolerance))

scoreRange(v, low, high) =>
    float lo = low * (1.0 - ratioTolerance)
    float hi = high * (1.0 + ratioTolerance)
    if not inRange(v, lo, hi)
        0.0
    else
        float mid = (lo + hi) * 0.5
        float half = math.max((hi - lo) * 0.5, syminfo.mintick)
        float err = math.abs(v - mid) / half
        100.0 * (1.0 - clamp01(err))

zoneSort(a, b) =>
    [math.min(a, b), math.max(a, b)]

zoneIntersect(l1, h1, l2, h2) =>
    float lo = math.max(l1, l2)
    float hi = math.min(h1, h2)
    [lo <= hi, lo, hi]

isInsideXA(pX, pA, pD) =>
    pD > math.min(pX, pA) and pD < math.max(pX, pA)

isOutsideXA(pX, pA, pD) =>
    pD < math.min(pX, pA) or pD > math.max(pX, pA)

isOutsideXSide(isBull, pX, pD) =>
    isBull ? (pD < pX) : (pD > pX)

projAD(isBull, pA, XA, ratio) =>
    isBull ? (pA - ratio * XA) : (pA + ratio * XA)

projCD(isBull, pC, BC, ratio) =>
    isBull ? (pC - ratio * BC) : (pC + ratio * BC)

projOX(isBull, pO, OX, ratio) =>
    isBull ? (pO + ratio * OX) : (pO - ratio * OX)

calcTimeScore(l1, l2, l3, l4) =>
    float mx = math.max(math.max(l1, l2), math.max(l3, l4))
    float mn = math.max(math.min(math.min(l1, l2), math.min(l3, l4)), 1.0)
    float rr = mx / mn
    float denom = math.max(maxLegBarRatio - 1.0, 0.0001)
    100.0 * (1.0 - clamp01((rr - 1.0) / denom))

candleConfirmAt(offset, isBull) =>
    bool ok = false
    if offset >= 0 and not na(close[offset]) and not na(open[offset]) and not na(close[offset + 1])
        ok := isBull ? (close[offset] > open[offset] and close[offset] > close[offset + 1]) : (close[offset] < open[offset] and close[offset] < close[offset + 1])
    ok

patternColor(pn, isBull) =>
    if pn == "Gartley"
        isBull ? #4ade80 : #22c55e
    else if pn == "Deep Gartley"
        isBull ? #16a34a : #15803d
    else if pn == "Bat"
        isBull ? #38bdf8 : #0ea5e9
    else if pn == "Alternate Bat"
        isBull ? #2563eb : #1d4ed8
    else if pn == "Butterfly"
        isBull ? #f59e0b : #d97706
    else if pn == "Crab"
        isBull ? #a855f7 : #9333ea
    else if pn == "Deep Crab"
        isBull ? #ef4444 : #dc2626
    else if pn == "Cypher"
        isBull ? #ec4899 : #db2777
    else if pn == "Shark 0.886" or pn == "Shark 1.13"
        isBull ? #06b6d4 : #0891b2
    else
        isBull ? #f43f5e : #e11d48

validationType(pn) =>
    pn == "Cypher" or pn == "Shark 0.886" or pn == "Shark 1.13" ? "XD" : pn == "5-0" ? "BD" : "XD+BD"

defaultCDMode(pn) =>
    pn == "Cypher" or pn == "Shark 0.886" or pn == "Shark 1.13" or pn == "5-0"

patternIdx(pn) =>
    if pn == "Gartley"
        0
    else if pn == "Deep Gartley"
        1
    else if pn == "Bat"
        2
    else if pn == "Alternate Bat"
        3
    else if pn == "Butterfly"
        4
    else if pn == "Crab"
        5
    else if pn == "Deep Crab"
        6
    else if pn == "Cypher"
        7
    else if pn == "Shark 0.886"
        8
    else if pn == "Shark 1.13"
        9
    else if pn == "5-0"
        10
    else
        -1

statAdd(arr, pn) =>
    int idx = patternIdx(pn)
    if idx >= 0
        array.set(arr, idx, array.get(arr, idx) + 1)
    0

statAddTotal(pn) => statAdd(statTotal, pn)
statAddTP1(pn) => statAdd(statTP1, pn)
statAddTP2(pn) => statAdd(statTP2, pn)
statAddSL(pn) => statAdd(statSL, pn)

pushSwing(pBar, pPrice, pType) =>
    bool changed = false
    int n = array.size(swType)
    if n == 0
        array.push(swBars, pBar)
        array.push(swPrice, pPrice)
        array.push(swType, pType)
        changed := true
    else
        int lt = array.get(swType, n - 1)
        float lp = array.get(swPrice, n - 1)
        if pType == lt
            bool moreExtreme = pType == 1 ? (pPrice > lp) : (pPrice < lp)
            if moreExtreme
                array.set(swBars, n - 1, pBar)
                array.set(swPrice, n - 1, pPrice)
                changed := true
        else
            array.push(swBars, pBar)
            array.push(swPrice, pPrice)
            array.push(swType, pType)
            changed := true
            if array.size(swBars) > 90
                array.shift(swBars)
                array.shift(swPrice)
                array.shift(swType)
    changed

scanSlot(len, pos) =>
    len * scanPivotDepth + pos

shiftScanState(len) =>
    int pos = scanPivotDepth - 1
    while pos > 0
        int dst = scanSlot(len, pos)
        int src = scanSlot(len, pos - 1)
        array.set(msPrice, dst, array.get(msPrice, src))
        array.set(msBar, dst, array.get(msBar, src))
        array.set(msType, dst, array.get(msType, src))
        pos -= 1
    0

candidatePivotPos(combo, idx) =>
    if combo == 0
        idx
    else if combo == 1
        idx < 4 ? idx : 5
    else if combo == 2
        idx < 3 ? idx : idx + 1
    else if combo == 3
        idx < 2 ? idx : idx + 1
    else if combo == 4
        idx == 0 ? 0 : idx + 1
    else
        idx + 1

validateXDBD(isBull, pA, pC, pD, XA, BC, r_ab_xa, r_bc_ab, r_cd_bc, r_ad_xa, timeScore, useAbNear, abNear, abLow, abHigh, bcLow, bcHigh, cdLow, cdHigh, useAdNear, adNear, adLow, adHigh) =>
    bool okAB = useAbNear ? nearTol(r_ab_xa, abNear) : inRangeTol(r_ab_xa, abLow, abHigh)
    bool okBC = inRangeTol(r_bc_ab, bcLow, bcHigh)
    bool okCD = inRangeTol(r_cd_bc, cdLow, cdHigh)
    bool okAD = useAdNear ? nearTol(r_ad_xa, adNear) : inRangeTol(r_ad_xa, adLow, adHigh)
    bool matched = false
    float score = na
    float przLow = na
    float przHigh = na
    if okAB and okBC and okCD and okAD
        float adR1 = useAdNear ? adNear : adLow
        float adR2 = useAdNear ? adNear : adHigh
        float adT1 = projAD(isBull, pA, XA, adR1)
        float adT2 = projAD(isBull, pA, XA, adR2)
        [adL, adH] = zoneSort(adT1, adT2)
        if useAdNear
            adL := adT1 - XA * ratioTolerance
            adH := adT1 + XA * ratioTolerance
        float cdT1 = projCD(isBull, pC, BC, cdLow)
        float cdT2 = projCD(isBull, pC, BC, cdHigh)
        [cdL, cdH] = zoneSort(cdT1, cdT2)
        [okP, pLo, pHi] = zoneIntersect(adL, adH, cdL, cdH)
        if okP and inRange(pD, pLo, pHi)
            matched := true
            przLow := pLo
            przHigh := pHi
            float rs = (useAbNear ? scoreNear(r_ab_xa, abNear) : scoreRange(r_ab_xa, abLow, abHigh))
            rs += scoreRange(r_bc_ab, bcLow, bcHigh)
            rs += scoreRange(r_cd_bc, cdLow, cdHigh)
            rs += (useAdNear ? scoreNear(r_ad_xa, adNear) : scoreRange(r_ad_xa, adLow, adHigh))
            rs /= 4.0
            float cluster = 100.0 * (1.0 - clamp01(math.abs(((adL + adH) * 0.5) - ((cdL + cdH) * 0.5)) / math.max(XA, syminfo.mintick)))
            score := 0.65 * rs + 0.25 * cluster + 0.10 * timeScore
    [matched, score, przLow, przHigh]

validateCypher(isBull, pX, pA, pC, pD, XA, r_ab_xa, r_bc_ab, r_xc_xa, r_xd_xa, r_cd_xc, XC, timeScore) =>
    bool matched = false
    float score = na
    float przLow = na
    float przHigh = na
    // Tighten Cypher to reduce false positives.
    float cyTol = math.min(ratioTolerance, 0.05)
    bool okAB = inRange(r_ab_xa, 0.382 * (1.0 - cyTol), 0.618 * (1.0 + cyTol))
    // Keep Cypher narrow to avoid eating Shark.
    bool okBC = inRange(r_bc_ab, 1.272 * (1.0 - cyTol), 1.414 * (1.0 + cyTol))
    bool cInsideXA = isBull ? (pC > pX and pC < pA) : (pC < pX and pC > pA)
    bool cOutsideXA = isBull ? (pC > pA) : (pC < pA)
    bool refMode = cypherLogicMode == "Reference (C outside XA)"
    bool okCRef = cOutsideXA and inRange(r_xc_xa, 1.272 * (1.0 - cyTol), 1.414 * (1.0 + cyTol))
    bool okCCustom = cInsideXA and inRange(r_xc_xa, 0.382 * (1.0 - cyTol), 0.886 * (1.0 + cyTol))
    bool okC = refMode ? okCRef : okCCustom
    bool okD = near(r_cd_xc, 0.786, cyTol)
    bool sharkOverlap = cOutsideXA and inRange(r_ab_xa, 0.382 * (1.0 - cyTol), 0.786 * (1.0 + cyTol)) and inRange(r_bc_ab, 1.13 * (1.0 - cyTol), 2.24 * (1.0 + cyTol)) and (near(r_xd_xa, 0.886, cyTol) or near(r_xd_xa, 1.13, cyTol))
    if okAB and okBC and okC and okD and not sharkOverlap
        float dTarget = projCD(isBull, pC, XC, 0.786)
        przLow := dTarget - XC * cyTol
        przHigh := dTarget + XC * cyTol
        if inRange(pD, przLow, przHigh)
            matched := true
            float rsC = refMode ? scoreRange(r_xc_xa, 1.272, 1.414) : scoreRange(r_xc_xa, 0.382, 0.886)
            float rs = (scoreRange(r_ab_xa, 0.382, 0.618) + scoreRange(r_bc_ab, 1.272, 1.414) + rsC + scoreNear(r_cd_xc, 0.786)) / 4.0
            score := 0.8 * rs + 0.2 * timeScore
    [matched, score, przLow, przHigh]

validateShark(isBull, pX, pA, pB, pC, pD, XA, r_ab_xa, r_bc_ab, r_cd_bc, r_xd_xa, timeScore, completionRatio) =>
    bool matched = false
    float score = na
    float przLow = na
    float przHigh = na
    float OX = math.abs(pA - pX)
    float shTol = math.max(ratioTolerance, 0.08)
    float otherCompletion = completionRatio < 1.0 ? 1.13 : 0.886
    bool bInsideXA = isInsideXA(pX, pA, pB)
    // keep backward compatibility for previously saved input value string
    bool refMode = sharkLogicMode == "Reference (XB/XA+AC/XA+BD/XA+XD/XA)" or sharkLogicMode == "Reference (XB/XA+AC/XA+BD/BC+XD/XA)" or sharkLogicMode == "Reference (AB/XA+BC/AB+CD/BC+XD/XA)"
    if refMode
        // Reference style from provided rule card:
        // XB/XA 0.382~0.618, AC/XA 1.13~1.618, BD/XA 1.618~2.24, XD/XA 0.886~1.13.
        float r_xb_xa = math.abs(pB - pX) / math.max(XA, syminfo.mintick)
        float r_ac_xa = math.abs(pC - pA) / math.max(XA, syminfo.mintick)
        float r_xc_xa = math.abs(pC - pX) / math.max(XA, syminfo.mintick)
        float r_bd_xa = math.abs(pD - pB) / math.max(XA, syminfo.mintick)
        float r_bd_bc = math.abs(pD - pB) / math.max(math.abs(pC - pB), syminfo.mintick)
        float xdMid = (0.886 + 1.13) * 0.5
        float xdLow = completionRatio < 1.0 ? 0.886 * (1.0 - shTol) : xdMid
        float xdHigh = completionRatio < 1.0 ? xdMid : 1.13 * (1.0 + shTol)
        bool okXB = inRange(r_xb_xa, 0.382 * (1.0 - shTol), 0.618 * (1.0 + shTol))
        bool okAC = inRange(r_ac_xa, 1.13 * (1.0 - shTol), 1.618 * (1.0 + shTol)) or inRange(r_xc_xa, 1.13 * (1.0 - shTol), 1.618 * (1.0 + shTol))
        bool okBD = inRange(r_bd_xa, 1.618 * (1.0 - shTol), 2.24 * (1.0 + shTol)) or inRange(r_bd_bc, 1.618 * (1.0 - shTol), 2.24 * (1.0 + shTol))
        bool okD = inRange(r_xd_xa, xdLow, xdHigh)
        bool cBeyondA = isBull ? (pC > pA) : (pC < pA)
        if bInsideXA and okXB and okAC and okBD and okD and cBeyondA
            float dDir = pD >= pX ? 1.0 : -1.0
            float dTargetLow = pX + dDir * XA * xdLow
            float dTargetHigh = pX + dDir * XA * xdHigh
            [dZoneLow, dZoneHigh] = zoneSort(dTargetLow, dTargetHigh)
            przLow := dZoneLow
            przHigh := dZoneHigh
            if inRange(pD, przLow, przHigh)
                matched := true
                float acScore = math.max(scoreRange(r_ac_xa, 1.13, 1.618), scoreRange(r_xc_xa, 1.13, 1.618))
                float bdScore = math.max(scoreRange(r_bd_xa, 1.618, 2.24), scoreRange(r_bd_bc, 1.618, 2.24))
                float rs = (scoreRange(r_xb_xa, 0.382, 0.618) + acScore + bdScore + scoreRange(r_xd_xa, 0.886, 1.13)) / 4.0
                score := 0.8 * rs + 0.2 * timeScore
    else
        // Classic OX mode.
        float r_b_ox = math.abs(pC - pA) / math.max(OX, syminfo.mintick)   // B / OX
        float r_c_ab = r_cd_bc                                               // C / AB
        float r_d_ox_x = math.abs(pD - pA) / math.max(OX, syminfo.mintick)  // D / OX (X-anchor)
        float r_d_ox_o = math.abs(pD - pX) / math.max(OX, syminfo.mintick)  // D / OX (O-anchor)
        bool okB = inRange(r_b_ox, 1.13 * (1.0 - shTol), 1.618 * (1.0 + shTol))
        bool okC = inRange(r_c_ab, 1.618 * (1.0 - shTol), 2.24 * (1.0 + shTol))
        float dErrX = math.abs(r_d_ox_x - completionRatio)
        float dErrO = math.abs(r_d_ox_o - completionRatio)
        float dErrXOther = math.abs(r_d_ox_x - otherCompletion)
        float dErrOOther = math.abs(r_d_ox_o - otherCompletion)
        bool closerToThis = math.min(dErrX, dErrO) <= math.min(dErrXOther, dErrOOther)
        bool okDX = near(r_d_ox_x, completionRatio, shTol)
        bool okDO = near(r_d_ox_o, completionRatio, shTol)
        bool okD = okDX or okDO
        bool bBreakX = isBull ? (pC > pA) : (pC < pA)
        if bInsideXA and okB and okC and okD and closerToThis and bBreakX
            float dTargetX = pA + (pD >= pA ? 1.0 : -1.0) * OX * completionRatio
            float dTargetO = pX + (pD >= pX ? 1.0 : -1.0) * OX * completionRatio
            float errX = math.abs(r_d_ox_x - completionRatio)
            float errO = math.abs(r_d_ox_o - completionRatio)
            float dTarget = okDX and (not okDO or errX <= errO) ? dTargetX : dTargetO
            przLow := dTarget - OX * shTol
            przHigh := dTarget + OX * shTol
            if inRange(pD, przLow, przHigh)
                matched := true
                float dScore = math.max(scoreNear(r_d_ox_x, completionRatio), scoreNear(r_d_ox_o, completionRatio))
                float rs = (scoreRange(r_b_ox, 1.13, 1.618) + scoreRange(r_c_ab, 1.618, 2.24) + dScore) / 3.0
                score := 0.8 * rs + 0.2 * timeScore
    [matched, score, przLow, przHigh]

validateFiveO(isBull, pX, pB, pC, pD, AB, BC, CD, r_ab_xa, r_bc_ab, r_cd_bc, timeScore) =>
    bool matched = false
    float score = na
    float przLow = na
    float przHigh = na
    float fTol = math.max(ratioTolerance, 0.06)
    float r_cd_ab = CD / math.max(AB, syminfo.mintick)
    bool bBreakX = isBull ? (pB < pX) : (pB > pX)
    bool ctxAB = inRange(r_ab_xa, 0.886 * (1.0 - fTol), 1.618 * (1.0 + fTol))
    bool ctxBC = inRange(r_bc_ab, 1.272 * (1.0 - fTol), 2.618 * (1.0 + fTol))
    bool sharkCtx = (bBreakX or ctxAB) and ctxBC
    bool okHalf = near(r_cd_bc, 0.5, fTol)
    bool okRecip = near(r_cd_ab, 1.0, fTol)
    if sharkCtx and okHalf and okRecip
        float t1 = projCD(isBull, pC, BC, 0.5)
        float t2 = projCD(isBull, pC, BC, AB / math.max(BC, syminfo.mintick))
        [okP, pLo, pHi] = zoneIntersect(t1 - BC * fTol, t1 + BC * fTol, t2 - BC * fTol, t2 + BC * fTol)
        if okP and inRange(pD, pLo, pHi)
            matched := true
            przLow := pLo
            przHigh := pHi
            float rsCtx = scoreRange(r_bc_ab, 1.272, 2.618)
            float rs = (scoreNear(r_cd_bc, 0.5) + scoreNear(r_cd_ab, 1.0) + rsCtx) / 3.0
            float cluster = 100.0 * (1.0 - clamp01(math.abs(t1 - t2) / math.max(BC, syminfo.mintick)))
            score := 0.7 * rs + 0.2 * cluster + 0.1 * timeScore
    [matched, score, przLow, przHigh]

calcLevels(pn, isBull, tD, pX, pA, pB, pC, pD, przLow, przHigh) =>
    float entry = pD
    // Avoid dynamic historical indexing (atrSeries[off]) to prevent
    // "requested historical offset is beyond buffer limit" runtime errors.
    float atrAt = nz(atrSeries)
    float buf = slBufferMode == "Percent" ? math.abs(entry) * slBufferPercent * 0.01 : atrAt * slAtrMult
    float sl = isBull ? (math.min(pD, przLow) - buf) : (math.max(pD, przHigh) + buf)
    if pn == "Cypher" and useCypherXStop
        sl := isBull ? math.min(sl, pX - buf) : math.max(sl, pX + buf)
    bool useCD = tpMode == "CD" ? true : tpMode == "AD" ? false : defaultCDMode(pn)
    float base = useCD ? math.abs(entry - pC) : math.abs(entry - pA)
    float tp1 = isBull ? (entry + base * 0.382) : (entry - base * 0.382)
    float tp2 = isBull ? (entry + base * 0.618) : (entry - base * 0.618)
    float tp3 = pB
    [entry, sl, tp1, tp2, tp3]

// Replay from D-bar to previous bar to avoid delayed-detection stat bias.
// outcome: 0=open, 1=SL, 2=TP2, 3=ambiguous pierce, 4=closed after TP1
replayTradeUntilPrevBar(isBull, tD, przLow, przHigh, tp1, tp2, sl) =>
    bool started = false
    bool tp1Done = false
    int outcome = 0
    float tol = hitTol()
    int maxOff = math.min(math.max(bar_index - tD, 0), 4998)
    int off = maxOff
    while off >= 1 and outcome == 0
        bool inPrz = isInPrzBar(high[off], low[off], przLow, przHigh, tol)
        if not started and inPrz
            started := true
        if started
            bool hitTP1 = isHitTP1Bar(isBull, high[off], low[off], tp1, tol)
            bool hitTP2 = isHitTP2Bar(isBull, high[off], low[off], tp2, tol)
            bool hitSL = isHitSLBar(isBull, high[off], low[off], sl, tol)
            if hitSL and (hitTP1 or hitTP2) and not tp1Done
                outcome := 3
            else
                if hitTP1 and not tp1Done
                    tp1Done := true
                if hitTP2
                    if not tp1Done
                        tp1Done := true
                    outcome := 2
                else if hitSL
                    outcome := tp1Done ? 4 : 1
        off -= 1
    [started, tp1Done, outcome]

calcLabelStatus(isBull, tD, przLow, przHigh, tp1, tp2, sl) =>
    bool started = false
    bool tp1Done = false
    bool pierced = false
    int outcome = 0 // 0=open, 1=SL, 2=TP, 3=pierced
    float tol = hitTol()
    int maxOff = math.min(math.max(bar_index - tD, 0), 4998)
    int off = maxOff
    while off >= 0 and outcome == 0
        bool inPrz = isInPrzBar(high[off], low[off], przLow, przHigh, tol)
        if not started and inPrz
            started := true
        if started
            bool hitTP1 = isHitTP1Bar(isBull, high[off], low[off], tp1, tol)
            bool hitTP2 = isHitTP2Bar(isBull, high[off], low[off], tp2, tol)
            bool hitSL = isHitSLBar(isBull, high[off], low[off], sl, tol)
            bool ambiguous = hitSL and (hitTP1 or hitTP2) and not tp1Done
            if ambiguous
                pierced := true
                outcome := 3
            else
                if hitTP1 and not tp1Done
                    tp1Done := true
                if hitTP2
                    outcome := 2
                else if hitSL
                    outcome := tp1Done ? 2 : 1
        off -= 1
    outcome == 1 ? "SL" : outcome == 2 ? "TP" : outcome == 3 ? "貫穿" : started ? "進行中" : "未啟動"

buildTradeLabelText(head, body, status) =>
    head + "[" + status + "] " + body

updateTradeLabelStatusAt(i, status) =>
    if i >= 0 and i < array.size(trLabelRef)
        label lb = array.get(trLabelRef, i)
        string head = array.get(trLabelHead, i)
        string body = array.get(trLabelBody, i)
        label.set_text(lb, buildTradeLabelText(head, body, status))
    0

removeTradeAt(i) =>
    array.remove(trKey, i)
    array.remove(trPattern, i)
    array.remove(trBull, i)
    array.remove(trPrzLow, i)
    array.remove(trPrzHigh, i)
    array.remove(trEntry, i)
    array.remove(trSL, i)
    array.remove(trTP1, i)
    array.remove(trTP2, i)
    array.remove(trStarted, i)
    array.remove(trTP1Hit, i)
    array.remove(trLabelRef, i)
    array.remove(trLabelHead, i)
    array.remove(trLabelBody, i)
    0

processTrades() =>
    bool evtPrz = false
    bool evtTP1 = false
    bool evtTP2 = false
    bool evtSL = false
    string msg = ""
    float tol = hitTol()
    if array.size(trKey) > 0
        for i = array.size(trKey) - 1 to 0
            string pn = array.get(trPattern, i)
            bool isBull = array.get(trBull, i)
            float przL = array.get(trPrzLow, i)
            float przH = array.get(trPrzHigh, i)
            float entry = array.get(trEntry, i)
            float sl = array.get(trSL, i)
            float tp1 = array.get(trTP1, i)
            float tp2 = array.get(trTP2, i)
            bool started = array.get(trStarted, i)
            bool tp1Done = array.get(trTP1Hit, i)

            if not started and isInPrzBar(high, low, przL, przH, tol)
                array.set(trStarted, i, true)
                evtPrz := true
                msg := "[" + (isBull ? "Bullish " : "Bearish ") + pn + "] Enter PRZ @ " + str.tostring(entry, format.mintick)

            bool hitTP1 = isHitTP1Bar(isBull, high, low, tp1, tol)
            bool hitTP2 = isHitTP2Bar(isBull, high, low, tp2, tol)
            bool hitSL = isHitSLBar(isBull, high, low, sl, tol)

            if array.get(trStarted, i)
                if hitSL and (hitTP1 or hitTP2) and not tp1Done
                    // ambiguous pierce bar
                    updateTradeLabelStatusAt(i, "貫穿")
                    removeTradeAt(i)
                else
                    if hitTP1 and not tp1Done
                        statAddTP1(pn)
                        array.set(trTP1Hit, i, true)
                        updateTradeLabelStatusAt(i, "TP")
                        evtTP1 := true
                        msg := "[" + (isBull ? "Bullish " : "Bearish ") + pn + "] TP1 hit @ " + str.tostring(tp1, format.mintick)

                    if hitTP2
                        if not array.get(trTP1Hit, i)
                            statAddTP1(pn)
                        statAddTP2(pn)
                        updateTradeLabelStatusAt(i, "TP")
                        evtTP2 := true
                        msg := "[" + (isBull ? "Bullish " : "Bearish ") + pn + "] TP2 hit @ " + str.tostring(tp2, format.mintick)
                        removeTradeAt(i)
                    else
                        if hitSL
                            if array.get(trTP1Hit, i)
                                updateTradeLabelStatusAt(i, "TP")
                                removeTradeAt(i)
                            else
                                statAddSL(pn)
                                updateTradeLabelStatusAt(i, "SL")
                                evtSL := true
                                msg := "[" + (isBull ? "Bullish " : "Bearish ") + pn + "] SL hit @ " + str.tostring(sl, format.mintick)
                                removeTradeAt(i)
    [evtPrz, evtTP1, evtTP2, evtSL, msg]

renderStats() =>
    if showStatsTable
        table.cell(statsTbl, 0, 0, "Pattern", text_color=color.white)
        table.cell(statsTbl, 1, 0, "Total", text_color=color.white)
        table.cell(statsTbl, 2, 0, "TP1 %", text_color=color.white)
        table.cell(statsTbl, 3, 0, "TP2 %", text_color=color.white)
        table.cell(statsTbl, 4, 0, "SL %", text_color=color.white)
        for i = 0 to array.size(patternNames) - 1
            string pn = array.get(patternNames, i)
            int total = array.get(statTotal, i)
            int tp1h = array.get(statTP1, i)
            int tp2h = array.get(statTP2, i)
            int slh = array.get(statSL, i)
            int resolved = tp1h + slh
            float p1 = resolved > 0 ? (100.0 * float(tp1h) / float(resolved)) : na
            float p2 = total > 0 ? (100.0 * float(tp2h) / float(total)) : na
            float ps = resolved > 0 ? (100.0 * float(slh) / float(resolved)) : na
            table.cell(statsTbl, 0, i + 1, pn, text_color=patternColor(pn, true))
            table.cell(statsTbl, 1, i + 1, str.tostring(total), text_color=color.white)
            table.cell(statsTbl, 2, i + 1, na(p1) ? "NA" : str.tostring(p1, "0.0") + "%", text_color=color.new(color.lime, 0))
            table.cell(statsTbl, 3, i + 1, na(p2) ? "NA" : str.tostring(p2, "0.0") + "%", text_color=color.new(color.aqua, 0))
            table.cell(statsTbl, 4, i + 1, na(ps) ? "NA" : str.tostring(ps, "0.0") + "%", text_color=color.new(color.red, 0))
    else
        table.clear(statsTbl, 0, 0, 4, 11)
    0

bool evtNewBull = false
bool evtNewBear = false
bool evtEnterPRZ = false
bool evtTP1 = false
bool evtTP2 = false
bool evtSL = false
string evtMsg = ""

int scanFrom = math.min(scanStartLen, scanEndLen)
int scanTo = math.max(scanStartLen, scanEndLen)
int scanStep = math.max(1, scanRangeStep)

for len = scanFrom to scanTo by scanStep
    if len <= scanLenCap
        int rightLen = math.max(len, pivotRightBars)
        int leftLen = math.max(1, pivotLeftBars)
        float ph = ta.pivothigh(high, leftLen, rightLen)
        float pl = ta.pivotlow(low, leftLen, rightLen)
        if not na(ph) or not na(pl)
            int currType = not na(ph) ? 1 : -1
            float currPrice = not na(ph) ? ph : pl
            int currBar = bar_index - rightLen
            int lastType = array.get(msLastType, len)
            int slot0 = scanSlot(len, 0)
            if currType == lastType
                float prevPrice = array.get(msPrice, slot0)
                bool moreExtreme = na(prevPrice) or (currType == 1 ? currPrice > prevPrice : currPrice < prevPrice)
                if moreExtreme
                    array.set(msPrice, slot0, currPrice)
                    array.set(msBar, slot0, currBar)
                    array.set(msType, slot0, currType)
            else
                shiftScanState(len)
                array.set(msPrice, slot0, currPrice)
                array.set(msBar, slot0, currBar)
                array.set(msType, slot0, currType)
                array.set(msLastType, len, currType)

emitPattern(pn, isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, score, przLow, przHigh) =>
    bool created = false
    bool eBull = false
    bool eBear = false
    bool ePrz = false
    string msg = ""

    bool dInPrz = inRange(pD, przLow, przHigh)
    int dOff = bar_index - tD
    bool strictOk = true
    if entryMode == "Strict"
        strictOk := false
        if dOff >= 0 and dOff <= 4998
            strictOk := useCandleConfirmation ? candleConfirmAt(dOff, isBull) : (bar_index > 0 ? (isBull ? (close > open and close > close[1]) : (close < open and close < close[1])) : false)
    bool okEntry = dInPrz and strictOk
    bool okDraw = dInPrz

    if okDraw
        [entry, sl, tp1, tp2, tp3] = calcLevels(pn, isBull, tD, pX, pA, pB, pC, pD, przLow, przHigh)
        string key = str.tostring(tX) + "_" + str.tostring(tA) + "_" + str.tostring(tB) + "_" + str.tostring(tC) + "_" + str.tostring(tD) + "_" + (isBull ? "B" : "S") + "_" + pn

        bool allow = not array.includes(emittedKeys, key)
        if allow and array.size(keepBull) > 0
            bool isSharkPattern = pn == "Shark 0.886" or pn == "Shark 1.13"
            int dedupeBars = isSharkPattern ? 1 : math.max(pivotRightBars * 2, math.max(1, scanRangeStep) * 2)
            float dedupeEntryTol = isSharkPattern ? math.max(0.0005, ratioTolerance * 0.08) : math.max(0.005, ratioTolerance * 0.5)
            for i = array.size(keepBull) - 1 to 0
                bool sameSide = array.get(keepBull, i) == isBull
                bool samePn = array.get(keepPn, i) == pn
                bool closeD = math.abs(array.get(keepD, i) - tD) <= dedupeBars
                bool closeE = math.abs(entry - array.get(keepEntry, i)) / math.max(math.abs(array.get(keepEntry, i)), syminfo.mintick) <= dedupeEntryTol
                if sameSide and samePn and closeD and closeE and array.get(keepScore, i) >= score
                    allow := false

        if allow
            color c = patternColor(pn, isBull)
            int tx = tD + projectionBars
            string labelStatus = calcLabelStatus(isBull, tD, przLow, przHigh, tp1, tp2, sl)
            line.new(tX, pX, tA, pA, color=c, width=2)
            line.new(tA, pA, tB, pB, color=c, width=2)
            line.new(tB, pB, tC, pC, color=c, width=2)
            line.new(tC, pC, tD, pD, color=c, width=2)
            line.new(tX, pX, tB, pB, color=color.new(c, 72), style=line.style_dotted)
            line.new(tA, pA, tC, pC, color=color.new(c, 72), style=line.style_dotted)

            if showRatioNumbers
                float XA_r = math.abs(pA - pX)
                float AB_r = math.abs(pB - pA)
                float BC_r = math.abs(pC - pB)
                float CD_r = math.abs(pD - pC)
                float AD_r = math.abs(pD - pA)
                float XB_r = math.abs(pB - pX)
                float AC_r = math.abs(pC - pA)
                float XD_r = math.abs(pD - pX)
                float BD_r = math.abs(pD - pB)
                float rAB = AB_r / math.max(XA_r, syminfo.mintick)   // AB / XA
                float rBC = BC_r / math.max(AB_r, syminfo.mintick)   // BC / AB
                float rCD = CD_r / math.max(BC_r, syminfo.mintick)   // CD / BC
                float rAD = AD_r / math.max(XA_r, syminfo.mintick)   // AD / XA
                float rXB = XB_r / math.max(XA_r, syminfo.mintick)   // XB / XA
                float rACDirect = AC_r / math.max(XA_r, syminfo.mintick)
                float rXC = math.abs(pC - pX) / math.max(XA_r, syminfo.mintick)
                float acMid = (1.13 + 1.618) * 0.5
                float rAC = math.abs(rACDirect - acMid) <= math.abs(rXC - acMid) ? rACDirect : rXC
                float rXD = XD_r / math.max(XA_r, syminfo.mintick)   // XD / XA
                float rBDXa = BD_r / math.max(XA_r, syminfo.mintick)
                float rBDBc = BD_r / math.max(BC_r, syminfo.mintick)
                float bdMid = (1.618 + 2.24) * 0.5
                float rBD = math.abs(rBDXa - bdMid) <= math.abs(rBDBc - bdMid) ? rBDXa : rBDBc
                bool isSharkPn = pn == "Shark 0.886" or pn == "Shark 1.13"

                int mXB = int(math.round((tX + tB) * 0.5))
                int mAC = int(math.round((tA + tC) * 0.5))
                int mCD = int(math.round((tC + tD) * 0.5))
                int mXD = int(math.round((tX + tD) * 0.5))
                int mBD = int(math.round((tB + tD) * 0.5))

                float yXB = (pX + pB) * 0.5
                float yAC = (pA + pC) * 0.5
                float yCD = (pC + pD) * 0.5
                float yXD = (pX + pD) * 0.5
                float yBD = (pB + pD) * 0.5

                if isSharkPn
                    label.new(mXB, yXB, fmtRatio(rXB), style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)
                    label.new(mAC, yAC, fmtRatio(rAC), style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)
                    line.new(tX, pX, tD, pD, color=color.new(c, 80), style=line.style_dotted)
                    line.new(tB, pB, tD, pD, color=color.new(c, 80), style=line.style_dotted)
                    label.new(mXD, yXD, fmtRatio(rXD), style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)
                    label.new(mBD, yBD, fmtRatio(rBD), style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)
                else
                    label.new(mXB, yXB, fmtRatio(rAB), style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)
                    label.new(mAC, yAC, fmtRatio(rBC), style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)
                    label.new(mCD, yCD, fmtRatio(rCD), style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)
                    line.new(tX, pX, tD, pD, color=color.new(c, 80), style=line.style_dotted)
                    line.new(tB, pB, tD, pD, color=color.new(c, 80), style=line.style_dotted)
                    label.new(mXD, yXD, fmtRatio(rAD), style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)
                    label.new(mBD, yBD, fmtRatio(BD_r / math.max(BC_r, syminfo.mintick)), style=label.style_none, textcolor=color.new(c, 0), size=size.tiny)

            if showPRZ
                box.new(tD, przHigh, tx, przLow, border_color=color.new(c, 0), bgcolor=color.new(c, 86))
                line.new(tD, przHigh, tx, przHigh, color=color.new(c, 40), style=line.style_dashed)
                line.new(tD, przLow, tx, przLow, color=color.new(c, 40), style=line.style_dashed)

            if showSLTP
                line.new(tD, entry, tx, entry, color=color.new(color.white, 40), style=line.style_dotted)
                line.new(tD, sl, tx, sl, color=color.new(color.red, 0), style=line.style_dashed)
                line.new(tD, tp1, tx, tp1, color=color.new(color.lime, 0), style=line.style_dashed)
                line.new(tD, tp2, tx, tp2, color=color.new(color.aqua, 0), style=line.style_dashed)
                if showTP3
                    line.new(tD, tp3, tx, tp3, color=color.new(color.yellow, 0), style=line.style_dashed)

            string labelHead = "[" + (isBull ? "Bullish " : "Bearish ") + pn + "]"
            string labelBody = validationType(pn) + (showScore ? (" (" + str.tostring(score, "#.0") + ")") : "")
            labelBody += "\nE " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick)
            labelBody += "\nTP1 " + str.tostring(tp1, format.mintick) + " | TP2 " + str.tostring(tp2, format.mintick)
            if showTP3
                labelBody += " | TP3 " + str.tostring(tp3, format.mintick)
            string txt = buildTradeLabelText(labelHead, labelBody, labelStatus)
            label patternLb = label.new(tD, pD, txt, style=isBull ? label.style_label_up : label.style_label_down, color=color.new(c, 78), textcolor=color.white, size=size.small)

            array.push(emittedKeys, key)
            array.push(keepBull, isBull)
            array.push(keepPn, pn)
            array.push(keepD, tD)
            array.push(keepEntry, entry)
            array.push(keepScore, score)
            if array.size(keepBull) > 400
                array.shift(keepBull)
                array.shift(keepPn)
                array.shift(keepD)
                array.shift(keepEntry)
                array.shift(keepScore)

            bool startedNow = false
            bool tp1Now = false
            if okEntry
                [histStarted, histTP1, histOutcome] = replayTradeUntilPrevBar(isBull, tD, przLow, przHigh, tp1, tp2, sl)
                if histOutcome == 1
                    statAddSL(pn)
                else if histOutcome == 2
                    statAddTP1(pn)
                    statAddTP2(pn)
                else if histOutcome == 4
                    statAddTP1(pn)
                else if histOutcome == 0
                    // TP1 already happened in historical replay but trade is still open for TP2.
                    // Count TP1 now to keep invariant: TP2 count must not exceed TP1 count.
                    if histTP1
                        statAddTP1(pn)
                    array.push(trKey, key)
                    array.push(trPattern, pn)
                    array.push(trBull, isBull)
                    array.push(trPrzLow, przLow)
                    array.push(trPrzHigh, przHigh)
                    array.push(trEntry, entry)
                    array.push(trSL, sl)
                    array.push(trTP1, tp1)
                    array.push(trTP2, tp2)
                    startedNow := histStarted or isInPrzBar(high, low, przLow, przHigh, hitTol())
                    tp1Now := histTP1
                    array.push(trStarted, startedNow)
                    array.push(trTP1Hit, tp1Now)
                    array.push(trLabelRef, patternLb)
                    array.push(trLabelHead, labelHead)
                    array.push(trLabelBody, labelBody)
            statAddTotal(pn)

            created := true
            eBull := isBull
            eBear := not isBull
            ePrz := startedNow
            msg := labelHead + " D=" + str.tostring(pD, format.mintick) + " SL=" + str.tostring(sl, format.mintick) + " TP1=" + str.tostring(tp1, format.mintick) + " TP2=" + str.tostring(tp2, format.mintick)

    [created, eBull, eBear, ePrz, msg]

for lenScan = scanFrom to scanTo by scanStep
    int tD = na
    int tC = na
    int tB = na
    int tA = na
    int tX = na
    float pD = na
    float pC = na
    float pB = na
    float pA = na
    float pX = na
    int sD = 0
    int sC = 0
    int sB = 0
    int sA = 0
    int sX = 0
    if lenScan <= scanLenCap
        int slot4 = scanSlot(lenScan, 4)
        if not na(array.get(msBar, slot4))
            tD := array.get(msBar, scanSlot(lenScan, 0))
            tC := array.get(msBar, scanSlot(lenScan, 1))
            tB := array.get(msBar, scanSlot(lenScan, 2))
            tA := array.get(msBar, scanSlot(lenScan, 3))
            tX := array.get(msBar, scanSlot(lenScan, 4))
            pD := array.get(msPrice, scanSlot(lenScan, 0))
            pC := array.get(msPrice, scanSlot(lenScan, 1))
            pB := array.get(msPrice, scanSlot(lenScan, 2))
            pA := array.get(msPrice, scanSlot(lenScan, 3))
            pX := array.get(msPrice, scanSlot(lenScan, 4))
            sD := array.get(msType, scanSlot(lenScan, 0))
            sC := array.get(msType, scanSlot(lenScan, 1))
            sB := array.get(msType, scanSlot(lenScan, 2))
            sA := array.get(msType, scanSlot(lenScan, 3))
            sX := array.get(msType, scanSlot(lenScan, 4))

    bool isBull = sX == -1 and sA == 1 and sB == -1 and sC == 1 and sD == -1
    bool isBear = sX == 1 and sA == -1 and sB == 1 and sC == -1 and sD == 1

    if isBull or isBear
        bool swingPriceOK = isBull ? (pA > pX and pB < pA and pC > pB and pD < pC) : (pA < pX and pB > pA and pC < pB and pD > pC)
        if swingPriceOK
            float XA = math.abs(pA - pX), AB = math.abs(pB - pA), BC = math.abs(pC - pB), CD = math.abs(pD - pC), XD = math.abs(pD - pX), XC = math.abs(pC - pX), AD = math.abs(pD - pA), BD = math.abs(pD - pB)
            if XA > syminfo.mintick and AB > syminfo.mintick and BC > syminfo.mintick and CD > syminfo.mintick and XC > syminfo.mintick
                float r_ab_xa = AB / XA, r_bc_ab = BC / AB, r_cd_bc = CD / BC, r_ad_xa = AD / XA, r_xd_xa = XD / XA, r_cd_xc = CD / XC, r_xc_xa = XC / XA
                float l1 = tA - tX, l2 = tB - tA, l3 = tC - tB, l4 = tD - tC
                float timeScore = calcTimeScore(l1, l2, l3, l4)
                bool passTime = true
                if useTimeSymmetry
                    float mx = math.max(math.max(l1, l2), math.max(l3, l4))
                    float mn = math.max(math.min(math.min(l1, l2), math.min(l3, l4)), 1.0)
                    passTime := mx / mn <= maxLegBarRatio
                bool passLeg = true
                if useMinLegSize
                    float minAmp = atrSeries * minLegATRMultiple
                    passLeg := XA >= minAmp and AB >= minAmp and BC >= minAmp and CD >= minAmp

                if passTime and passLeg
                    bool bestHit = false
                    string bestPn = ""
                    float bestSc = na
                    float bestPL = na
                    float bestPH = na

                    // helper inline for add/emit
                    if enableGartley
                        [m, s, plzL, plzH] = validateXDBD(isBull, pA, pC, pD, XA, BC, r_ab_xa, r_bc_ab, r_cd_bc, r_ad_xa, timeScore, true, 0.618, 0.0, 0.0, 0.382, 0.886, 1.13, 1.618, true, 0.786, 0.0, 0.0)
                        if m and isInsideXA(pX, pA, pD)
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Gartley"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Gartley", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableDeepGartley
                        [m, s, plzL, plzH] = validateXDBD(isBull, pA, pC, pD, XA, BC, r_ab_xa, r_bc_ab, r_cd_bc, r_ad_xa, timeScore, false, 0.0, 0.707, 0.786, 0.382, 0.886, 1.27, 1.618, true, 0.886, 0.0, 0.0)
                        if m and isInsideXA(pX, pA, pD)
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Deep Gartley"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Deep Gartley", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableBat
                        [m, s, plzL, plzH] = validateXDBD(isBull, pA, pC, pD, XA, BC, r_ab_xa, r_bc_ab, r_cd_bc, r_ad_xa, timeScore, false, 0.0, 0.382, 0.50, 0.382, 0.886, 1.618, 2.618, true, 0.886, 0.0, 0.0)
                        if m and r_ab_xa < 0.618 * (1.0 + ratioTolerance) and isInsideXA(pX, pA, pD)
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Bat"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Bat", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableAltBat
                        [m, s, plzL, plzH] = validateXDBD(isBull, pA, pC, pD, XA, BC, r_ab_xa, r_bc_ab, r_cd_bc, r_ad_xa, timeScore, true, 0.382, 0.0, 0.0, 0.382, 0.886, 2.0, 3.618, true, 1.13, 0.0, 0.0)
                        if m and r_ab_xa <= 0.382 * (1.0 + ratioTolerance) and isOutsideXSide(isBull, pX, pD)
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Alternate Bat"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Alternate Bat", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableButterfly
                        [m, s, plzL, plzH] = validateXDBD(isBull, pA, pC, pD, XA, BC, r_ab_xa, r_bc_ab, r_cd_bc, r_ad_xa, timeScore, true, 0.786, 0.0, 0.0, 0.382, 0.886, 1.618, 2.618, false, 0.0, 1.27, 1.618)
                        if m and isOutsideXSide(isBull, pX, pD)
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Butterfly"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Butterfly", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableCrab
                        [m, s, plzL, plzH] = validateXDBD(isBull, pA, pC, pD, XA, BC, r_ab_xa, r_bc_ab, r_cd_bc, r_ad_xa, timeScore, false, 0.0, 0.382, 0.618, 0.382, 0.886, 2.24, 3.618, true, 1.618, 0.0, 0.0)
                        if m and isOutsideXSide(isBull, pX, pD)
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Crab"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Crab", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableDeepCrab
                        [m, s, plzL, plzH] = validateXDBD(isBull, pA, pC, pD, XA, BC, r_ab_xa, r_bc_ab, r_cd_bc, r_ad_xa, timeScore, true, 0.886, 0.0, 0.0, 0.382, 0.886, 2.24, 3.618, true, 1.618, 0.0, 0.0)
                        if m and isOutsideXSide(isBull, pX, pD)
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Deep Crab"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Deep Crab", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableCypher
                        [m, s, plzL, plzH] = validateCypher(isBull, pX, pA, pC, pD, XA, r_ab_xa, r_bc_ab, r_xc_xa, r_xd_xa, r_cd_xc, XC, timeScore)
                        bool cypherDGate = cypherLogicMode == "Custom (C inside XA)" ? isInsideXA(pX, pA, pD) : true
                        if m and cypherDGate
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Cypher"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Cypher", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableShark0886
                        [m, s, plzL, plzH] = validateShark(isBull, pX, pA, pB, pC, pD, XA, r_ab_xa, r_bc_ab, r_cd_bc, r_xd_xa, timeScore, 0.886)
                        if m
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Shark 0.886"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Shark 0.886", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableShark113
                        [m, s, plzL, plzH] = validateShark(isBull, pX, pA, pB, pC, pD, XA, r_ab_xa, r_bc_ab, r_cd_bc, r_xd_xa, timeScore, 1.13)
                        if m
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "Shark 1.13"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("Shark 1.13", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if enableFiveO
                        [m, s, plzL, plzH] = validateFiveO(isBull, pX, pB, pC, pD, AB, BC, CD, r_ab_xa, r_bc_ab, r_cd_bc, timeScore)
                        if m
                            if showOnlyBestPattern
                                if not bestHit or s > bestSc
                                    bestHit := true
                                    bestPn := "5-0"
                                    bestSc := s
                                    bestPL := plzL
                                    bestPH := plzH
                            else
                                [cr, eb, er, ep, mmsg] = emitPattern("5-0", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                evtNewBull := evtNewBull or eb
                                evtNewBear := evtNewBear or er
                                evtEnterPRZ := evtEnterPRZ or ep
                                if cr
                                    evtMsg := mmsg

                    if showOnlyBestPattern and bestHit
                        [cr, eb, er, ep, mmsg] = emitPattern(bestPn, isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, bestSc, bestPL, bestPH)
                        evtNewBull := evtNewBull or eb
                        evtNewBear := evtNewBear or er
                        evtEnterPRZ := evtEnterPRZ or ep
                        if cr
                            evtMsg := mmsg

// Extra Shark scan: keep 6 pivots per length and test all 5-point combinations.
// This recovers valid Shark structures when one small intermediate pivot breaks the latest 5-point chain.
for lenScan = scanFrom to scanTo by scanStep
    if lenScan <= scanLenCap
        for combo = 1 to scanComboCount - 1
            int dPos = candidatePivotPos(combo, 0)
            int cPos = candidatePivotPos(combo, 1)
            int bPos = candidatePivotPos(combo, 2)
            int aPos = candidatePivotPos(combo, 3)
            int xPos = candidatePivotPos(combo, 4)
            int slotX = scanSlot(lenScan, xPos)
            if not na(array.get(msBar, slotX))
                int tD = array.get(msBar, scanSlot(lenScan, dPos))
                int tC = array.get(msBar, scanSlot(lenScan, cPos))
                int tB = array.get(msBar, scanSlot(lenScan, bPos))
                int tA = array.get(msBar, scanSlot(lenScan, aPos))
                int tX = array.get(msBar, slotX)
                float pD = array.get(msPrice, scanSlot(lenScan, dPos))
                float pC = array.get(msPrice, scanSlot(lenScan, cPos))
                float pB = array.get(msPrice, scanSlot(lenScan, bPos))
                float pA = array.get(msPrice, scanSlot(lenScan, aPos))
                float pX = array.get(msPrice, slotX)
                int sD = array.get(msType, scanSlot(lenScan, dPos))
                int sC = array.get(msType, scanSlot(lenScan, cPos))
                int sB = array.get(msType, scanSlot(lenScan, bPos))
                int sA = array.get(msType, scanSlot(lenScan, aPos))
                int sX = array.get(msType, slotX)

                bool isBull = sX == -1 and sA == 1 and sB == -1 and sC == 1 and sD == -1
                bool isBear = sX == 1 and sA == -1 and sB == 1 and sC == -1 and sD == 1

                if isBull or isBear
                    bool swingPriceOK = isBull ? (pA > pX and pB < pA and pC > pB and pD < pC) : (pA < pX and pB > pA and pC < pB and pD > pC)
                    if swingPriceOK
                        float XA = math.abs(pA - pX), AB = math.abs(pB - pA), BC = math.abs(pC - pB), CD = math.abs(pD - pC), XD = math.abs(pD - pX), XC = math.abs(pC - pX), AD = math.abs(pD - pA)
                        if XA > syminfo.mintick and AB > syminfo.mintick and BC > syminfo.mintick and CD > syminfo.mintick and XC > syminfo.mintick
                            float r_ab_xa = AB / XA, r_bc_ab = BC / AB, r_cd_bc = CD / BC, r_ad_xa = AD / XA, r_xd_xa = XD / XA, r_cd_xc = CD / XC, r_xc_xa = XC / XA
                            float l1 = tA - tX, l2 = tB - tA, l3 = tC - tB, l4 = tD - tC
                            float timeScore = calcTimeScore(l1, l2, l3, l4)
                            bool passTime = true
                            if useTimeSymmetry
                                float mx = math.max(math.max(l1, l2), math.max(l3, l4))
                                float mn = math.max(math.min(math.min(l1, l2), math.min(l3, l4)), 1.0)
                                passTime := mx / mn <= maxLegBarRatio
                            bool passLeg = true
                            if useMinLegSize
                                float minAmp = atrSeries * minLegATRMultiple
                                passLeg := XA >= minAmp and AB >= minAmp and BC >= minAmp and CD >= minAmp

                            if passTime and passLeg
                                bool bestHit = false
                                string bestPn = ""
                                float bestSc = na
                                float bestPL = na
                                float bestPH = na

                                if enableShark0886
                                    [m, s, plzL, plzH] = validateShark(isBull, pX, pA, pB, pC, pD, XA, r_ab_xa, r_bc_ab, r_cd_bc, r_xd_xa, timeScore, 0.886)
                                    if m
                                        if showOnlyBestPattern
                                            if not bestHit or s > bestSc
                                                bestHit := true
                                                bestPn := "Shark 0.886"
                                                bestSc := s
                                                bestPL := plzL
                                                bestPH := plzH
                                        else
                                            [cr, eb, er, ep, mmsg] = emitPattern("Shark 0.886", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                            evtNewBull := evtNewBull or eb
                                            evtNewBear := evtNewBear or er
                                            evtEnterPRZ := evtEnterPRZ or ep
                                            if cr
                                                evtMsg := mmsg

                                if enableShark113
                                    [m, s, plzL, plzH] = validateShark(isBull, pX, pA, pB, pC, pD, XA, r_ab_xa, r_bc_ab, r_cd_bc, r_xd_xa, timeScore, 1.13)
                                    if m
                                        if showOnlyBestPattern
                                            if not bestHit or s > bestSc
                                                bestHit := true
                                                bestPn := "Shark 1.13"
                                                bestSc := s
                                                bestPL := plzL
                                                bestPH := plzH
                                        else
                                            [cr, eb, er, ep, mmsg] = emitPattern("Shark 1.13", isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, s, plzL, plzH)
                                            evtNewBull := evtNewBull or eb
                                            evtNewBear := evtNewBear or er
                                            evtEnterPRZ := evtEnterPRZ or ep
                                            if cr
                                                evtMsg := mmsg

                                if showOnlyBestPattern and bestHit
                                    [cr, eb, er, ep, mmsg] = emitPattern(bestPn, isBull, tX, tA, tB, tC, tD, pX, pA, pB, pC, pD, bestSc, bestPL, bestPH)
                                    evtNewBull := evtNewBull or eb
                                    evtNewBear := evtNewBear or er
                                    evtEnterPRZ := evtEnterPRZ or ep
                                    if cr
                                        evtMsg := mmsg

[evPrz2, evTP1_2, evTP2_2, evSL2, msg2] = processTrades()
evtEnterPRZ := evtEnterPRZ or evPrz2
evtTP1 := evtTP1 or evTP1_2
evtTP2 := evtTP2 or evTP2_2
evtSL := evtSL or evSL2
if msg2 != ""
    evtMsg := msg2

renderStats()

alertcondition(evtNewBull, "New Bullish Pattern Completed", "New bullish harmonic pattern completed")
alertcondition(evtNewBear, "New Bearish Pattern Completed", "New bearish harmonic pattern completed")
alertcondition(evtEnterPRZ, "Price Entered PRZ", "Price entered PRZ")
alertcondition(evtTP1, "TP1 Hit", "TP1 hit")
alertcondition(evtTP2, "TP2 Hit", "TP2 hit")
alertcondition(evtSL, "SL Hit", "SL hit")

if enableRuntimeAlert and evtMsg != ""
    alert(evtMsg, alert.freq_once_per_bar_close)



